# Konfigurasi persekitaran untuk Sistem Pengurusan Kokurikulum (SPK)
# Salin fail ini ke .env dan laraskan nilai jika perlu.

# Pangkalan data SQLite (prototaip - lalai)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# --- Alternatif: Supabase PostgreSQL ---
# Untuk menggunakan Supabase, tukar provider dalam prisma/schema.prisma ke "postgresql",
# kemudian gunakan connection string Supabase berikut (gantikan [YOUR-PASSWORD]):
# DATABASE_URL=postgresql://postgres.utklxsfikcpwtubrjbts:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# Pastikan juga jalankan: bun run db:generate && bun run db:push && bun run prisma/seed.ts
